# Образец настроек. Скопировать в game/.env и при необходимости поправить.
# Ключи и пароли сюда не писать — только в game/.env (он не попадает в git).

NODE_ENV=development

# База данных. Локально — PostgreSQL пакетом npm (embedded-postgres), без Docker.
PG_DATA_DIR=.data/pg
PG_PORT=5433
DATABASE_URL=postgres://postgres:postgres@localhost:5433/bunker

# Сервер игры
API_PORT=8787

# Собранный контент (pnpm content:build)
CONTENT_FILE=packages/content/dist/starting.json
# Правила и закрытые материалы — только для сервера (P-10)
SERVER_CONTENT_FILE=packages/content/dist/server.json


# Вход и почта (этап 6a-1, ML-A).
# AUTH=link — вход по ссылке на почту (у каждого игрока своё дело); AUTH=off — один игрок
# без входа, как раньше.
AUTH=link
# mailpit — ловушка писем на компьютере (pnpm dev сам скачает и запустит её; письма —
# http://localhost:8025); memory — письма только в памяти (автотесты); none — без почты.
MAIL_TRANSPORT=mailpit
MAILPIT_URL=http://127.0.0.1:8025
# Отправитель писем бюро. На сервере (6b) — ящик на домене автора.
MAIL_FROM=zapros@blackwood-bi.org
MAIL_FROM_NAME=Окружное бюро расследований
# Адрес игры для ссылок в письмах (в разработке — Vite).
PUBLIC_URL=http://localhost:5173
