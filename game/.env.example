# Образец настроек. Скопировать в game/.env и при необходимости поправить.
# Ключи и пароли сюда не писать — только в game/.env (он не попадает в git).

NODE_ENV=development

# База данных. Локально — PostgreSQL пакетом npm (embedded-postgres), без Docker.
PG_DATA_DIR=.data/pg
PG_PORT=5433
DATABASE_URL=postgres://postgres:postgres@localhost:5433/bunker

# Сервер игры
API_PORT=8787

# Собранный контент (pnpm content:build)
CONTENT_FILE=packages/content/dist/starting.json
# Правила и закрытые материалы — только для сервера (P-10)
SERVER_CONTENT_FILE=packages/content/dist/server.json
