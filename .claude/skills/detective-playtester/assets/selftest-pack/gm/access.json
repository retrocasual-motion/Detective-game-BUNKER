{
  "version": 1,
  "default_reply": {
    "ПАРОЛЬ": "Такого объекта нет.",
    "ЗАПРОС": "Адресат не найден.",
    "ПОИСК": "Ничего не найдено."
  },
  "rules": [
    {
      "id": "pw-mail",
      "action": "ПАРОЛЬ",
      "target": "почт",
      "accept": [
        "^мурка$"
      ],
      "release": [
        "L01"
      ],
      "ok": "Вход выполнен.",
      "fail": "Неверный пароль.",
      "target_label": "почта секретаря"
    },
    {
      "id": "req-log",
      "action": "ЗАПРОС",
      "target": "архив",
      "accept": [
        "журнал\\w* посещ"
      ],
      "release": [
        "L02"
      ],
      "ok": "Архив прислал журнал посещений.",
      "fail": "Архив: уточните, какой документ нужен.",
      "target_label": "архив музея",
      "intent": "Журнал посещений музея: кто входил и выходил по электронным картам ночью.",
      "required": []
    }
  ]
}